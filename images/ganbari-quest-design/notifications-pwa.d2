}
direction: down

S: "subscribe API"
V: "検証\nhttps + allowlist"
E: "400 + warn\n+ Discord"
N: "正規化して保存"
C: "cron 15 分毎"
R: "送信前に\n再検証"
P: "web-push\nで POST"

S -> V
V -> E: "NG"
V -> N: "OK"
N -> C
C -> R
R -> P
