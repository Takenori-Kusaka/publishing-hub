vars: {
  d2-config: {
    layout-engine: dagre
  }
}
direction: down

M: "マーケット\nプレイス"
A: "管理画面へ\n遷移"
D: "誰に追加?\nダイアログ"
P: "per-child\ninstance 生成"
F: "family master\n1 record"

M -> A
A -> D
D -> P
D -> F
