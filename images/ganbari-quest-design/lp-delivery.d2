# 文言の SSOT を静的 HTML まで届ける（正本: books/ganbari-quest-design/lp-delivery.md）
# 一方向のフローなので layout は dagre（TALA は公式に「DAG は苦手」と明記）。
vars: {
  d2-config: {
    layout-engine: dagre
  }
}
direction: down

T: "terms.ts\n単一の用語"
L: "labels.ts\n表示文字列"
G: "generate-lp-labels"
S: "shared-labels.js"
P: "DOMPurify\nsanitize"
H: "LP の DOM"

T -> L
L -> G
G -> S
S -> P
P -> H
