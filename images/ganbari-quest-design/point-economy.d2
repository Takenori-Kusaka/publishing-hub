# 自動生成チャレンジ: 中期目標の層（正本: books/ganbari-quest-design/point-economy.md）
# 一方向のフローなので layout は dagre（TALA は公式に「DAG は苦手」と明記）。
vars: {
  d2-config: {
    layout-engine: dagre
  }
}
direction: down

P: "前週の結果"
J1: "達成した?" { shape: diamond }
U: "目標 +1〜2\n上限 7"
J2: "半分以上?" { shape: diamond }
K: "目標を据え置き"
J3: "2 週連続未達?" { shape: diamond }
R: "最小目標\n得意分野"
D: "目標 -1\n下限 2"

P -> J1
J1 -> U: "はい"
J1 -> J2: "いいえ"
J2 -> K: "はい"
J2 -> J3: "いいえ"
J3 -> R: "はい"
J3 -> D: "いいえ"
