# 原稿は git の index に LF で入れる(Z10 / Q14 / N12)。コミットする人やエージェントの core.autocrlf に依らず、
# CRLF でステージされても LF に正規化される。差分が全行の書き換えに見えて人の査読を妨げるのを防ぐ。
articles/**/*.md text eol=lf
books/**/*.md text eol=lf
books/**/*.yaml text eol=lf
platforms/**/*.md text eol=lf
social/posts/*.yaml text eol=lf

# テキストは種類を問わず index に LF で入れる。scripts/ や docs/ が対象外だったため、
# core.autocrlf=true の環境(WSL など)でコミットすると全行が書き換わった差分になり、査読できなかった。
* text=auto eol=lf

# 画像と .d2 の出力は変換しない
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
