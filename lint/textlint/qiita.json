{
  "//": "Qiita(課題解決バリアント)向けの校正プロファイル。短く断定的に。留保表現(かもしれません)と煽りの「！」を抑え、レシピとして読める文にする。",
  "plugins": {
    "@textlint/markdown": {
      "extensions": [
        ".md"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 120
      },
      "ja-no-mixed-period": {
        "allowPeriodMarks": [
          ":",
          "："
        ],
        "allowEmojiAtEnd": true
      },
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "ですます",
        "preferInList": "",
        "strict": false
      },
      "no-exclamation-question-mark": {
        "allowHalfWidthExclamation": false,
        "allowFullWidthExclamation": false,
        "allowHalfWidthQuestion": true,
        "allowFullWidthQuestion": true
      },
      "ja-no-weak-phrase": {
        "severity": "warning"
      },
      "max-comma": {
        "max": 5
      },
      "max-ten": {
        "max": 3
      },
      "max-kanji-continuous-len": {
        "max": 6,
        "allow": [
          "再生可能エネルギー",
          "情報処理推進機構",
          "産業技術総合研究所"
        ]
      },
      "no-doubled-joshi": {
        "min_interval": 1,
        "strict": false,
        "allow": []
      }
    },
    "@textlint-rule/pattern": {
      "patterns": [
        {
          "message": "ハングル・韓国語の文字が含まれています。日本語に修正してください。",
          "pattern": "/[\\uac00-\\ud7a3\\u1100-\\u11ff\\u3130-\\u318f]/u"
        },
        {
          "message": "「**」の開始デリミタが開始約物と密着し、かつ左側が空白でも約物でもありません。CommonMark の境界ルールで太字になりません。アスタリスクの左側に半角スペースを空けるか、カッコの内側に移動してください。",
          "pattern": "/(?<![\\s、。！？：:（「『])\\*\\*([「『（])/u"
        },
        {
          "message": "「**」の終了デリミタが終了約物と密着し、かつ右側が空白でも約物でもありません。CommonMark の境界ルールで太字になりません。アスタリスクの右側に半角スペースを空けるか、カッコの内側に移動してください。",
          "pattern": "/([」』）])\\*\\*(?![\\s、。！？：:）」』]|$)/u"
        },
        {
          "message": "「いたします」（謙譲語）は Qiita のレシピ記事には過剰です。「します」に修正してください。",
          "pattern": "/(いたし|致し)ます/u"
        },
        {
          "message": "「いただきます」（謙譲語）は Qiita のレシピ記事には過剰です。「します」「得ます」に修正してください。",
          "pattern": "/(いただき|いただきます)/u"
        },
        {
          "message": "和文の中に英語の機能語(of / the / and / for / with / from)が混ざっています。「JPEGの」のように日本語で書いてください",
          "pattern": "/(?<=[぀-ヿ㐀-鿿A-Za-z0-9）」])\\s(?:of|the|and|for|with|from)\\s(?=[`぀-ヿ㐀-鿿（「])/u"
        },
        {
          "message": "「〇いたい」は誤りです(い音便の後に「たい」は続きません)。「置きたい」「書きたい」のように連用形にしてください",
          "pattern": "/(置|書|聞|咲|歩|泣|抜|弾|敷|履|吹|招|磨|描|働|動|開|届|続|着|付|焼|驚|嘆|輝|築|拓|頂|解|叩|巻|浮|向|効|利)いたい/u"
        }
      ]
    }
  }
}
