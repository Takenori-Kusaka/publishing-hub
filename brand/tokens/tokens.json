{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "日下武紀の個人ブランドの設計トークン(正本)。W3C Design Tokens 形式のサブセット。dist/ は scripts/build-tokens.mjs が生成する。色の根拠は brand/01-color.md と research/02-color-research.md、決定は decisions/BDR-0002。段の明度は OKLCH で固定(50: 0.975 … 950: 0.22)し、彩度は色相と明度を保ったまま sRGB に入るまで落とす(scripts/color-math.mjs)。生成り(paper.100)上の WCAG 2.x コントラスト比を $description に記録する",
  "color": {
    "ai": {
      "$description": "藍(あい)。機械・構造・本文の見出し。和色大辞典の紺色 #223a70 を基準に段を生成。『ジャパンブルー』、職人の重ね染め。静けさと信頼の連想(Jonauskaite 2020)",
      "50": { "$type": "color", "$value": "#f3f7ff" },
      "100": { "$type": "color", "$value": "#e9edf5" },
      "200": { "$type": "color", "$value": "#d6dbe4" },
      "300": { "$type": "color", "$value": "#b8c1d4", "$description": "ダークモードの見出し・リンク" },
      "400": { "$type": "color", "$value": "#96a5c2" },
      "500": { "$type": "color", "$value": "#7386ac", "$description": "生成り上 3.50(非文字・大きな文字のみ)" },
      "600": { "$type": "color", "$value": "#556b98", "$description": "生成り上 5.10(AA)" },
      "700": { "$type": "color", "$value": "#3c5486", "$description": "生成り上 7.17(AAA)。リンクの色" },
      "800": { "$type": "color", "$value": "#253d73", "$description": "生成り上 10.08。主色。見出し・図の機械側" },
      "900": { "$type": "color", "$value": "#132858" },
      "950": { "$type": "color", "$value": "#07173f" }
    },
    "human": {
      "$description": "丹(に)。人が触る場所(ピットイン=判定の場)にだけ使う合図の色。販促・強調には使わない。和色大辞典の丹色 #e45e32。鳥居・魔除けの境界の赤。朱系は色覚多様性に配慮した赤(CUD の推奨)",
      "50": { "$type": "color", "$value": "#fff4f1" },
      "100": { "$type": "color", "$value": "#ffe7df", "$description": "人の判定を示す帯・背景" },
      "200": { "$type": "color", "$value": "#ffcebf" },
      "300": { "$type": "color", "$value": "#ffa88c" },
      "400": { "$type": "color", "$value": "#f87b54", "$description": "ダークモードのアクセント(#16181d 上 6.78)" },
      "500": { "$type": "color", "$value": "#e45e32", "$description": "丹色そのもの。面と大きな文字(生成り上 3.38、白文字 3.5 は 24px 以上の太字のみ)" },
      "600": { "$type": "color", "$value": "#b2431e", "$description": "生成り上 5.41(AA)。文字・線・小さな記号" },
      "700": { "$type": "color", "$value": "#8f3415", "$description": "生成り上 7.53(AAA)" },
      "800": { "$type": "color", "$value": "#6d260d" },
      "900": { "$type": "color", "$value": "#4c1908" },
      "950": { "$type": "color", "$value": "#310e04" }
    },
    "growth": {
      "$description": "千歳緑(ちとせみどり)。常緑樹の変わらぬ緑。成長・採用・成功。和色大辞典 #316745。丹と並べるときは明度差 0.15 以上と形の併用が要る(プロタン型での分離が弱いため)",
      "50": { "$type": "color", "$value": "#f0faf2" },
      "100": { "$type": "color", "$value": "#e4f1e7" },
      "200": { "$type": "color", "$value": "#cde0d3" },
      "300": { "$type": "color", "$value": "#aec9b6" },
      "400": { "$type": "color", "$value": "#8caf96", "$description": "ダークモードの緑" },
      "500": { "$type": "color", "$value": "#679275" },
      "600": { "$type": "color", "$value": "#477958", "$description": "生成り上 4.85(AA)" },
      "700": { "$type": "color", "$value": "#316745", "$description": "千歳緑そのもの。生成り上 6.37。文字・採用の印" },
      "800": { "$type": "color", "$value": "#1b4b2e" },
      "900": { "$type": "color", "$value": "#0c341d" },
      "950": { "$type": "color", "$value": "#02210f" }
    },
    "ink": {
      "$description": "墨。本文の文字。純黒を避け、藍の色相を 2% だけ含む(#2a2f3a、生成り上 12.83)",
      "100": { "$type": "color", "$value": "#e9edf6" },
      "200": { "$type": "color", "$value": "#d7dbe3" },
      "300": { "$type": "color", "$value": "#bdc1c9", "$description": "図の補助線・目盛" },
      "400": { "$type": "color", "$value": "#a1a5ad" },
      "500": { "$type": "color", "$value": "#82868e", "$description": "生成り上 3.49。大きな文字と非文字のみ" },
      "600": { "$type": "color", "$value": "#686c75", "$description": "生成り上 5.04(AA)。補助文・出典・日付" },
      "700": { "$type": "color", "$value": "#51555f" },
      "800": { "$type": "color", "$value": "#3b404a" },
      "900": { "$type": "color", "$value": "#2a2f3a", "$description": "本文" }
    },
    "paper": {
      "$description": "紙。漂白しない布と紙の色。和紙系のオフホワイト",
      "100": { "$type": "color", "$value": "#fbfaf5", "$description": "生成り色。ページの地" },
      "200": { "$type": "color", "$value": "#f8f4e6", "$description": "象牙色。カード・囲み" },
      "300": { "$type": "color", "$value": "#efeee9", "$description": "コードの地。色相を持たせない" },
      "400": { "$type": "color", "$value": "#e3ddd1", "$description": "罫線。Lc は低いので太さ 1.5px 以上で補う" }
    },
    "warn": {
      "$description": "黄土。暫定・未検証・見直し期限つきの記述(根拠水準マーク)。警告の色を販促の黄色と混同しない",
      "100": { "$type": "color", "$value": "#f9ebd3", "$description": "暫定の囲みの地" },
      "300": { "$type": "color", "$value": "#d3be98" },
      "600": { "$type": "color", "$value": "#866627", "$description": "生成り上 5.10(AA)。暫定の文字・罫" },
      "700": { "$type": "color", "$value": "#6c5017" }
    },
    "danger": {
      "$description": "弁柄(べんがら)と緋。却下・禁止・差し戻し。土と鉄の沈んだ赤を文字に、緋を面に",
      "text": { "$type": "color", "$value": "#8f2e14", "$description": "弁柄色。生成り上 7.8" },
      "face": { "$type": "color", "$value": "#d3381c", "$description": "緋色。面・大きな文字のみ(4.6)" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.ink.900}" },
      "secondary": { "$type": "color", "$value": "{color.ink.600}" },
      "inverse": { "$type": "color", "$value": "{color.paper.100}" },
      "link": { "$type": "color", "$value": "{color.ai.700}", "$description": "下線を必ず付ける" }
    },
    "surface": {
      "page": { "$type": "color", "$value": "{color.paper.100}" },
      "card": { "$type": "color", "$value": "{color.paper.200}" },
      "code": { "$type": "color", "$value": "{color.paper.300}" },
      "machine": { "$type": "color", "$value": "{color.ai.800}", "$description": "図の機械・AI 側の面" },
      "human": { "$type": "color", "$value": "{color.human.500}", "$description": "図の人が触る場所の面" }
    },
    "border": {
      "line": { "$type": "color", "$value": "{color.paper.400}" },
      "strong": { "$type": "color", "$value": "{color.ink.300}" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "{color.ai.800}" },
      "accent": { "$type": "color", "$value": "{color.human.500}", "$description": "人が触る場所にだけ" },
      "accentText": { "$type": "color", "$value": "{color.human.600}" }
    },
    "state": {
      "success": { "$type": "color", "$value": "{color.growth.700}" },
      "warningText": { "$type": "color", "$value": "{color.warn.600}" },
      "warningBg": { "$type": "color", "$value": "{color.warn.100}" },
      "dangerText": { "$type": "color", "$value": "{color.danger.text}" },
      "dangerFace": { "$type": "color", "$value": "{color.danger.face}" },
      "interpretation": { "$type": "color", "$value": "{color.ai.300}", "$description": "著者の解釈の左罫" }
    }
  },
  "dark": {
    "$description": "ダークモードの上書き。純黒を避け(#16181d、藍の色相)、アクセントは 1 段明るく、彩度を落とす(research/02 5 章)",
    "color": {
      "text": {
        "primary": { "$type": "color", "$value": "#e8e6df", "$description": "#16181d 上 14.2" },
        "secondary": { "$type": "color", "$value": "#a1a5ad" },
        "inverse": { "$type": "color", "$value": "#16181d" },
        "link": { "$type": "color", "$value": "#b8c1d4", "$description": "#16181d 上 9.8" }
      },
      "surface": {
        "page": { "$type": "color", "$value": "#16181d" },
        "card": { "$type": "color", "$value": "#1e2129" },
        "code": { "$type": "color", "$value": "#22262f" },
        "machine": { "$type": "color", "$value": "#3c5486" },
        "human": { "$type": "color", "$value": "#f87b54" }
      },
      "border": {
        "line": { "$type": "color", "$value": "#2e323b" },
        "strong": { "$type": "color", "$value": "#51555f" }
      },
      "brand": {
        "primary": { "$type": "color", "$value": "#b8c1d4" },
        "accent": { "$type": "color", "$value": "#f87b54", "$description": "#16181d 上 6.78" },
        "accentText": { "$type": "color", "$value": "#f87b54" }
      },
      "state": {
        "success": { "$type": "color", "$value": "#8caf96" },
        "warningText": { "$type": "color", "$value": "#d3be98" },
        "warningBg": { "$type": "color", "$value": "#2a2416" },
        "dangerText": { "$type": "color", "$value": "#ffa88c" },
        "dangerFace": { "$type": "color", "$value": "#d3381c" },
        "interpretation": { "$type": "color", "$value": "#3c5486" }
      }
    }
  },
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": ["BIZ UDPGothic", "Noto Sans JP", "sans-serif"], "$description": "見出しと図の文字。UD(ユニバーサルデザイン)書体。製造現場の掲示と同じ系統の読みやすさ" },
      "body": { "$type": "fontFamily", "$value": ["Noto Sans JP", "BIZ UDPGothic", "sans-serif"], "$description": "本文。最も広く配布され、60 年の入手性が最も高い" },
      "code": { "$type": "fontFamily", "$value": ["UDEV Gothic", "Consolas", "monospace"], "$description": "コード・識別子・数値の列。BIZ UD ゴシックと JetBrains Mono の合成。見出しと同じ骨格" },
      "latin": { "$type": "fontFamily", "$value": ["Noto Sans JP", "sans-serif"], "$description": "欧文を別書体にしない。和文書体の欧文グリフを使う(混植の規則は brand/02-typography.md)" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "body": { "$type": "dimension", "$value": "1rem" },
      "small": { "$type": "dimension", "$value": "0.875rem" },
      "h1": { "$type": "dimension", "$value": "1.75rem" },
      "h2": { "$type": "dimension", "$value": "1.375rem" },
      "h3": { "$type": "dimension", "$value": "1.125rem" }
    },
    "lineHeight": {
      "body": { "$type": "number", "$value": 1.9, "$description": "日本語の本文。1.7〜2.0 の範囲(JLReq の慣行)" },
      "heading": { "$type": "number", "$value": 1.4 },
      "code": { "$type": "number", "$value": 1.6 }
    },
    "letterSpacing": {
      "heading": { "$type": "dimension", "$value": "0.02em" },
      "body": { "$type": "dimension", "$value": "0.01em" }
    }
  },
  "figure": {
    "$description": "図の寸法規則。brand/05-figures.md",
    "minFontRatio": { "$type": "number", "$value": 0.03125, "$description": "ラベルの最小フォントサイズ = 自然幅 × 1/32(電話での縮小に耐える)" },
    "stroke": {
      "track": { "$type": "dimension", "$value": "22", "$description": "キービジュアルのコース(内側の速いループ)の線幅" },
      "ring": { "$type": "dimension", "$value": "6", "$description": "外殻の環の線幅" },
      "line": { "$type": "dimension", "$value": "3" }
    },
    "radius": {
      "box": { "$type": "dimension", "$value": "14" },
      "pill": { "$type": "dimension", "$value": "999" }
    }
  }
}
